<?xml version="1.0" encoding="UTF-8"?>

<!-- Frequency modulation - the WTGENERATOR.md section 4.3 worked example.
     Automate mod_index or mod_hz at audio rate and the carrier reacts every
     sample, with no script re-run and no wavetable re-render. -->

<ParameterSet output-mode="expression" analysis="GenericOverlay">
  <Float name="carrier_hz" minVal="20"  maxVal="20000" defaultVal="1000"/>
  <Float name="mod_hz"     minVal="0.1" maxVal="2000"  defaultVal="100"/>
  <Float name="mod_index"  minVal="0"   maxVal="12"    defaultVal="2"/>
  <Float name="amp"        minVal="0"   maxVal="1"     defaultVal="0.5"/>
  <Expression>amp * sin(2 * pi * carrier_hz * t + mod_index * sin(2 * pi * mod_hz * t))</Expression>
</ParameterSet>
